{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/_server/(.*)", "destination": "/api/index?path=/_server/$1" },
    { "source": "/((?!assets|favicon).*)", "destination": "/api/index" }
  ]
}
